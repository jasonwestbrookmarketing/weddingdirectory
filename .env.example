# ─────────────────────────────────────────────────────────────────────────────
# storyvenue.com (public directory) environment variables.
#
# All writes (listing edits, lead capture) go through app.storyvenue.com.
# This site is read-only against StoryPay's shared Supabase project.
# ─────────────────────────────────────────────────────────────────────────────

# StoryPay's Supabase project (ref: blclfnsztrxfhcfauzer — the current live
# project, matching StoryPay/.env.local).
# IMPORTANT: this MUST match the Supabase project that app.storyvenue.com uses,
# otherwise the directory cannot see the venues the dashboard is writing.
NEXT_PUBLIC_SUPABASE_URL=https://blclfnsztrxfhcfauzer.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# StoryPay dashboard base URL (used for "List Your Venue" / "Venue Login" CTAs).
NEXT_PUBLIC_STORYPAY_URL=https://app.storyvenue.com

# Lead webhook — storyvenue.com signs each lead and POSTs it to StoryPay.
# STORYPAY_LEAD_WEBHOOK_SECRET must match LEAD_WEBHOOK_SECRET on app.storyvenue.com.
STORYPAY_LEAD_WEBHOOK_URL=https://app.storyvenue.com/api/public/leads
STORYPAY_LEAD_WEBHOOK_SECRET=

# Mapbox — required for the venue map on the search page and venue detail pages.
# Create a token at https://account.mapbox.com/access-tokens/ with the default
# public scopes (styles:read, tiles:read, etc.).
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Funnel A/B testing (hero headline / subheadline / CTA on landing pages).
# Both are required for the experiment system + /admin/funnels to work. Without
# them the hero renders its default copy and the admin page shows a setup notice.
# ─────────────────────────────────────────────────────────────────────────────

# Service-role key for StoryPay's Supabase project (same project as above).
# Used ONLY server-side to read variant config and write impression/click counts.
# Run db/funnel_ab_testing.sql in Supabase once before this takes effect.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the super-admin dashboard at /admin/funnels.
FUNNEL_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Strategy Call funnel — server-side Meta Conversions API fallback.
# The client-side pixel (FireLeadEvent) fires fbq('track','Lead') on
# /strategy-call/confirmed, but that's lossy (ad blockers, in-app browsers,
# Safari ITP, interrupted redirects). GHL calls our webhook the moment a
# booking is made so we can send the same conversion server-to-server too.
# ─────────────────────────────────────────────────────────────────────────────

# Meta Conversions API access token for the pixel above (NEXT_PUBLIC_META_PIXEL_ID).
# Generate one in Events Manager → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=

# Shared secret GHL's Workflow "Webhook" action must send as ?secret= or the
# x-webhook-secret header when POSTing to /api/ghl/strategy-call-booked.
# Set this to a long random string (e.g. `openssl rand -hex 32`).
GHL_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Removed — no longer used on this site:
#   SENDGRID_API_KEY / SENDGRID_FROM_EMAIL (StoryPay sends lead emails now)
#   WASABI_* (image uploads moved to StoryPay dashboard)
#   ADMIN_INVITE_CODE / ADMIN_SECRET (admin UI removed)
# ─────────────────────────────────────────────────────────────────────────────
